# Image registry namespace and tag used by docker-compose to name locally built images.
# Adjust REPO if you push to a specific registry (e.g. quay.io/yourname).
REPO=robotshop
TAG=latest

# Build arg consumed by the web image when downloading the Instana Nginx tracing
# module. The bundled .so files are used when this is empty, so a real key is
# optional for local development.
INSTANA_AGENT_KEY=
